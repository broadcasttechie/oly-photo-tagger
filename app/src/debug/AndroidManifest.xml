<?xml version="1.0" encoding="utf-8"?>
<!--
    Merged into the debug variant's manifest only (see AGP's per-build-type source set
    convention) — this receiver and its Kotlin source under src/debug/java both stay
    structurally absent from a release build. exported="true" with no intent-filter/
    permission is fine here specifically because of that: the only realistic caller is
    `adb shell am broadcast -n ...` during development, and every action it exposes just
    re-runs the same read-mostly Home-screen operations (a scan, a cache clear) any app with
    the DCIM folder's own SAF grant could already trigger through the real UI.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugControlReceiver"
            android:exported="true" />
    </application>
</manifest>
