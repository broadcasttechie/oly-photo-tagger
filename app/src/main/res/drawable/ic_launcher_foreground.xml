<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A fully transparent 1x1 path rather than zero paths: ic_launcher_background.png
         is the full icon artwork already, so nothing should visibly layer on top of it,
         but some adaptive-icon tooling doesn't handle a path-less vector cleanly. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0L1,0L1,1L0,1Z" />
</vector>
